##! experimental.givens
import "../auto_recalls.malloy"

// The queries behind dashboards/recall-anatomy.jsx. A repo dashboard's queries
// live here, in the model's governed surface — the component only names them
// with useQuery({ query: "<name>" }) and draws the result.

#" Where cars break — every NHTSA recall campaign mapped to the part of the car it fixes.
# artifact { title="Recall Anatomy: where cars break" }
query: category_summary is auto_recalls -> {
  group_by: component_category
  aggregate:
    recall_count
    total_affected_vehicles
    do_not_drive is do_not_drive_advisories
    park_outside is park_outside_advisories
    avg_completion is avg_completion_rate
  order_by: recall_count desc
}

// Campaigns per part per year — the mix chart and each part's sparkline.
// 2025 is the last complete year of reporting.
query: category_by_year is auto_recalls -> {
  where: `Report Received Date`.year >= @1980 and `Report Received Date`.year <= @2025
  group_by:
    component_category
    recall_year is year(`Report Received Date`)
  aggregate: recall_count
  order_by: recall_year
}

// Top 5 NHTSA component codes within each part of the car.
query: top_components_by_category is auto_recalls -> {
  where: Component != null
  group_by: component_category, Component
  aggregate: recall_count
} -> {
  group_by: component_category, Component, recall_count
  calculate: rk is row_number() { partition_by: component_category; order_by: recall_count desc }
} -> {
  where: rk <= 5
  select: component_category, Component, recall_count, rk
  order_by: component_category, rk
}

// Top 5 manufacturers within each part of the car.
query: top_manufacturers_by_category is auto_recalls -> {
  where: Manufacturer != null
  group_by: component_category, Manufacturer
  aggregate: recall_count
} -> {
  group_by: component_category, Manufacturer, recall_count
  calculate: rk is row_number() { partition_by: component_category; order_by: recall_count desc }
} -> {
  where: rk <= 5
  select: component_category, Manufacturer, recall_count, rk
  order_by: component_category, rk
}

// The 4 campaigns that named the most vehicles within each part of the car.
query: largest_campaigns_by_category is auto_recalls -> {
  where: `Potentially Affected` > 0
  group_by:
    component_category
    nhtsa_id is `NHTSA ID`
    recall_url
    Manufacturer
    Subject
    recall_date is `Report Received Date`
    affected is `Potentially Affected`
    do_not_drive is `Do Not Drive Advisory`
} -> {
  group_by: component_category, nhtsa_id, recall_url, Manufacturer, Subject, recall_date, affected, do_not_drive
  calculate: rk is row_number() { partition_by: component_category; order_by: affected desc }
} -> {
  where: rk <= 4
  select: component_category, rk, recall_date, Manufacturer, Subject, affected, do_not_drive, recall_url
  order_by: component_category, rk
}
